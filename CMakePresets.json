{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cc65/debug",
            "cacheVariables": {
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cc65/release",
            "cacheVariables": {
                "BUILD_TESTING": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "targets": [
                "all"
            ]
        },
        {
            "name": "cc65/Release",
            "configurePreset": "cc65/Release",
            "targets": [
                "all"
            ]
        }
    ]
}
