{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Spy: build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "cc65/Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Spy: test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/cc65/release",
                "--output-on-failure"
            ],
            "problemMatcher": []
        }
    ]
}
