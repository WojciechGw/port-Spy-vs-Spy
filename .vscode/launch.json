{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Spy vs Spy - emulator",
            "type": "lldb-dap",
            "request": "launch",
            "debugAdapterExecutable": "${workspaceFolder}/tools/rp6502-emu",
            "debugAdapterArgs": [
                "--dap",
                "--phi2",
                "8000"
            ],
            "windows": {
                "debugAdapterExecutable": "${workspaceFolder}/tools/rp6502-emu.exe"
            },
            "program": "${workspaceFolder}/build/cc65/release/spy-vs-spy.rp6502",
            "stopOnEntry": false,
            "stopOnExit": true,
            "preLaunchTask": "Spy: build"
        },
        {
            "name": "Spy vs Spy - Pico",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/tools/rp6502.py",
            "args": [
                "run",
                "-c",
                "${workspaceFolder}/.rp6502",
                "${workspaceFolder}/build/cc65/release/spy-vs-spy.rp6502"
            ],
            "preLaunchTask": "Spy: build"
        }
    ]
}
